{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cortex.moskv/schemas/llm-router-attestation/v1.json",
  "title": "LLM Router Attestation Receipt",
  "description": "Cryptographic receipt for verifiable execution provenance in LLM Routing, defining structural bounds without asserting physical model reality.",
  "type": "object",
  "required": [
    "schema",
    "receipt_id",
    "request_id",
    "created_at",
    "prompt_commitment",
    "response_commitment",
    "routing",
    "execution",
    "router_signature"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "llm-router-attestation/v1"
    },
    "receipt_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "prompt_commitment": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "type": "string" },
        "value": { "type": "string" },
        "nonce_commitment": { "type": "string" }
      }
    },
    "response_commitment": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "type": "string" },
        "value": { "type": "string" }
      }
    },
    "routing": {
      "type": "object",
      "required": ["policy_id", "policy_version", "policy_hash", "selected_provider", "model_version"],
      "properties": {
        "policy_id": { "type": "string" },
        "policy_version": { "type": "string" },
        "policy_hash": { "type": "string" },
        "selected_provider": { "type": "string" },
        "model_alias": { "type": "string" },
        "model_version": { "type": "string" },
        "region": { "type": "string" }
      }
    },
    "execution": {
      "type": "object",
      "required": ["ttft_ms", "total_latency_ms", "input_tokens", "output_tokens", "fallback_used"],
      "properties": {
        "ttft_ms": { "type": "integer" },
        "total_latency_ms": { "type": "integer" },
        "input_tokens": { "type": "integer" },
        "output_tokens": { "type": "integer" },
        "fallback_used": { "type": "boolean" },
        "attempt_count": { "type": "integer" }
      }
    },
    "provider_receipt": {
      "type": "object",
      "required": ["receipt_hash", "signature", "signing_key_id"],
      "properties": {
        "receipt_hash": { "type": "string" },
        "signature": { "type": "string" },
        "signing_key_id": { "type": "string" }
      }
    },
    "router_signature": {
      "type": "object",
      "required": ["algorithm", "public_key_id", "signature"],
      "properties": {
        "algorithm": { "type": "string" },
        "public_key_id": { "type": "string" },
        "signature": { "type": "string" }
      }
    }
  }
}
