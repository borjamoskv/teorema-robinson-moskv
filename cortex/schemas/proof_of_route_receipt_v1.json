{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cortex.moskv/schemas/proof-of-route/v1.json",
  "title": "Proof-of-Route Receipt",
  "description": "Cryptographic flight recorder for LLM routing utility decisions, incorporating regret and shadow metrics.",
  "type": "object",
  "required": [
    "schema",
    "receipt_id",
    "request_id",
    "created_at",
    "prompt_commitment",
    "utility_estimation",
    "routing_decision",
    "execution",
    "router_signature"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "proof-of-route/v1"
    },
    "receipt_id": { "type": "string" },
    "request_id": { "type": "string" },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "prompt_commitment": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "type": "string" },
        "value": { "type": "string" },
        "nonce_commitment": { "type": "string" }
      }
    },
    "response_commitment": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "type": "string" },
        "value": { "type": "string" }
      }
    },
    "utility_estimation": {
      "type": "object",
      "required": ["estimated_quality", "estimated_ttft_ms", "estimated_cost_usd", "route_confidence"],
      "properties": {
        "estimated_quality": { "type": "number", "minimum": 0, "maximum": 1 },
        "estimated_ttft_ms": { "type": "integer" },
        "estimated_cost_usd": { "type": "number" },
        "estimated_p_fail": { "type": "number", "minimum": 0, "maximum": 1 },
        "route_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "routing_decision": {
      "type": "object",
      "required": ["policy_id", "policy_version", "policy_hash", "selected_provider", "model_version"],
      "properties": {
        "policy_id": { "type": "string" },
        "policy_version": { "type": "string" },
        "policy_hash": { "type": "string" },
        "selected_provider": { "type": "string" },
        "model_alias": { "type": "string" },
        "model_version": { "type": "string" },
        "region": { "type": "string" },
        "fallback_policy": { "type": "string" }
      }
    },
    "execution": {
      "type": "object",
      "required": ["ttft_ms", "total_latency_ms", "input_tokens", "output_tokens"],
      "properties": {
        "ttft_ms": { "type": "integer" },
        "total_latency_ms": { "type": "integer" },
        "input_tokens": { "type": "integer" },
        "output_tokens": { "type": "integer" },
        "fallback_used": { "type": "boolean" },
        "attempt_count": { "type": "integer" }
      }
    },
    "shadow_evaluation": {
      "type": "object",
      "description": "Optional payload populated only if this request was part of the 1-5% Shadow Route traffic.",
      "properties": {
        "shadow_provider": { "type": "string" },
        "shadow_model_version": { "type": "string" },
        "shadow_ttft_ms": { "type": "integer" },
        "shadow_cost_usd": { "type": "number" },
        "measured_regret": { "type": "number" }
      }
    },
    "provider_receipt": {
      "type": "object",
      "properties": {
        "receipt_hash": { "type": "string" },
        "signature": { "type": "string" },
        "signing_key_id": { "type": "string" }
      }
    },
    "router_signature": {
      "type": "object",
      "required": ["algorithm", "public_key_id", "signature"],
      "properties": {
        "algorithm": { "type": "string" },
        "public_key_id": { "type": "string" },
        "signature": { "type": "string" }
      }
    }
  }
}
