{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cortex.moskv/schemas/proof-of-route/v1.json",
  "title": "Proof-of-Route Receipt",
  "description": "Contextual router flight recorder. Cryptographically demonstrates decision making with uncertainty, propensity tracking, and counterfactual evaluation capabilities.",
  "type": "object",
  "required": [
    "schema",
    "receipt_id",
    "request_id",
    "created_at",
    "prompt_commitment",
    "response_commitment",
    "routing_decision",
    "predictions",
    "actuals",
    "router_signature"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "proof-of-route/v1"
    },
    "receipt_id": { "type": "string" },
    "request_id": { "type": "string" },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "prompt_commitment": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "type": "string", "const": "hmac-sha256" },
        "value": { "type": "string" }
      }
    },
    "response_commitment": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "type": "string", "const": "hmac-sha256" },
        "value": { "type": "string" }
      }
    },
    "routing_decision": {
      "type": "object",
      "required": ["policy_id", "policy_hash", "router_build_hash", "selected_provider", "model_version", "selection_propensity"],
      "properties": {
        "policy_id": { "type": "string" },
        "policy_hash": { "type": "string" },
        "router_build_hash": { "type": "string" },
        "candidate_set_hash": { "type": "string" },
        "selected_provider": { "type": "string" },
        "model_alias": { "type": "string" },
        "model_version": { "type": "string" },
        "region": { "type": "string" },
        "selection_propensity": { "type": "number", "minimum": 0, "maximum": 1, "description": "Probability of selecting this model, enabling off-policy counterfactual evaluation (IPS)." },
        "shadow_policy": { "type": "string" }
      }
    },
    "predictions": {
      "type": "object",
      "required": ["quality_mean", "quality_lcb_95", "ttft_p95_ms", "cost_usd", "failure_probability"],
      "properties": {
        "quality_mean": { "type": "number" },
        "quality_lcb_95": { "type": "number", "description": "Lower Confidence Bound of estimated quality. Punishes high uncertainty." },
        "ttft_p95_ms": { "type": "integer", "description": "Upper Confidence Bound of latency." },
        "cost_usd": { "type": "number" },
        "failure_probability": { "type": "number" }
      }
    },
    "actuals": {
      "type": "object",
      "required": ["ttft_ms", "total_latency_ms", "input_tokens", "output_tokens", "fallback_used"],
      "properties": {
        "ttft_ms": { "type": "integer" },
        "total_latency_ms": { "type": "integer" },
        "input_tokens": { "type": "integer" },
        "output_tokens": { "type": "integer" },
        "fallback_used": { "type": "boolean" },
        "verifiable_outcome_score": { "type": "number", "description": "Optional level-5 evidence metric if a concrete signal exists (e.g., CI tests passed, CSAT)." }
      }
    },
    "provider_receipt": {
      "type": "object",
      "properties": {
        "receipt_hash": { "type": "string" },
        "signature": { "type": "string" },
        "signing_key_id": { "type": "string" }
      }
    },
    "router_signature": {
      "type": "object",
      "required": ["algorithm", "public_key_id", "signature"],
      "properties": {
        "algorithm": { "type": "string" },
        "public_key_id": { "type": "string" },
        "signature": { "type": "string" }
      }
    }
  }
}
