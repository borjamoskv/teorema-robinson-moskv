{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cortex.moskv/schemas/proof-of-route/execution/v0.2.json",
  "title": "Proof-of-Route Execution Receipt",
  "description": "T1: Cryptographic proof of the actual execution metrics.",
  "type": "object",
  "required": ["schema", "receipt_id", "decision_receipt_hash", "payload", "payload_hash", "signature"],
  "properties": {
    "schema": { "type": "string", "const": "proof-of-route/execution/v0.2" },
    "receipt_id": { "type": "string" },
    "decision_receipt_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "payload": {
      "type": "object",
      "required": ["status", "ttft_ms", "total_latency_ms", "input_tokens", "output_tokens", "cost_microusd", "fallback_used", "response_commitment"],
      "properties": {
        "status": { "type": "string" },
        "ttft_ms": { "type": "integer" },
        "total_latency_ms": { "type": "integer" },
        "input_tokens": { "type": "integer" },
        "output_tokens": { "type": "integer" },
        "cost_microusd": { "type": "integer" },
        "fallback_used": { "type": "boolean" },
        "response_commitment": { "type": "string", "pattern": "^hmac-sha256:[a-f0-9]{64}$" },
        "provider_receipt_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "payload_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "signature": {
      "type": "object",
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "type": "string", "enum": ["Ed25519"] },
        "key_id": { "type": "string" },
        "value": { "type": "string", "pattern": "^base64url:[A-Za-z0-9_-]+={0,2}$" }
      }
    }
  }
}
