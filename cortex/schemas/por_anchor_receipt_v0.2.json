{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cortex.moskv/schemas/proof-of-route/anchor/v0.2.json",
  "title": "Proof-of-Route Anchor Receipt",
  "description": "T3: Cryptographic proof of blockchain anchoring for a batch of receipts.",
  "type": "object",
  "required": ["schema", "receipt_id", "payload", "payload_hash", "signature"],
  "properties": {
    "schema": { "type": "string", "const": "proof-of-route/anchor/v0.2" },
    "receipt_id": { "type": "string" },
    "payload": {
      "type": "object",
      "required": ["batch_id", "merkle_root", "leaf_count", "network", "tx_hash", "block_number"],
      "properties": {
        "batch_id": { "type": "string" },
        "merkle_root": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "leaf_count": { "type": "integer" },
        "network": { "type": "string" },
        "tx_hash": { "type": "string" },
        "block_number": { "type": "integer" }
      }
    },
    "payload_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "signature": {
      "type": "object",
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "type": "string", "enum": ["Ed25519"] },
        "key_id": { "type": "string" },
        "value": { "type": "string", "pattern": "^base64url:[A-Za-z0-9_-]+={0,2}$" }
      }
    }
  }
}
