{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProofOfRouteReceiptSchemaV02_1_EvidenceCalibrated",
  "type": "object",
  "properties": {
    "decision_receipt": {
      "type": "object",
      "properties": {
        "request_id": {"type": "string"},
        "routing_policy": {
          "type": "object",
          "properties": {
            "selected_route": {"type": "string"},
            "selection_propensity": {"type": "number"}
          }
        },
        "shadow_policy": {
          "type": "object",
          "properties": {
            "eligible": {"type": "boolean"},
            "inclusion_probability": {"type": "number"}
          }
        }
      }
    },
    "execution_receipt": {
      "type": "object",
      "properties": {
        "measurement_source": {"type": "string"},
        "streaming_enabled": {"type": "boolean"},
        "ttft_ms": {"type": "number"},
        "total_latency_ms": {"type": "number"}
      }
    },
    "evaluation_receipt": {
      "type": "object",
      "properties": {
        "quality_proxy_basis_points": {"type": "integer"},
        "utility_basis_points": {"type": "integer"},
        "observed_proxy_regret_basis_points": {"type": "integer"},
        "evaluator_hash": {"type": "string"},
        "utility_spec_hash": {"type": "string"}
      },
      "required": ["observed_proxy_regret_basis_points"]
    },
    "aggregate_evaluation_report": {
      "type": "object",
      "properties": {
        "cohort_id": {"type": "string"},
        "metric": {"type": "string"},
        "estimate_basis_points": {"type": "number"},
        "confidence_interval_95_basis_points": {
          "type": "array",
          "items": {"type": "number"},
          "minItems": 2,
          "maxItems": 2
        },
        "sample_size": {"type": "integer"},
        "estimator": {"type": "string"},
        "period_start": {"type": "string"},
        "period_end": {"type": "string"}
      }
    }
  }
}
