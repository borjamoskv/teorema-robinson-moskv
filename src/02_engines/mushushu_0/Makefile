# Axiom Ω25 Deterministic Build
CC = clang
CFLAGS = -O3 -Wall -Wextra -dynamiclib

TARGET = libmushushu_0.dylib
SRC = mushushu_0.c

build:
	@echo "[MUSHUSHU-0] Construyendo vanguardia BFT (mushushu_0)..."
	$(CC) $(CFLAGS) -o $(TARGET) $(SRC)
	@echo "[PASS] libmushushu_0.dylib generado determinísticamente."

clean:
	@echo "[CORTEX] Ejecutando purga termodinámica (Ω24)..."
	rm -f $(TARGET)
